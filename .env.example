# 复制为 .env 并填入你自己的路径

# Zotero 可执行文件路径（Windows 用反斜杠，注意转义）
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = C:\Program Files\Zotero\zotero.exe

# 开发用 profile（建议单独建一个，别用日常使用的）
ZOTERO_PLUGIN_PROFILE_PATH = C:\Users\YourName\ZoteroDevProfile

# 数据目录（留空则使用 profile 默认）
ZOTERO_PLUGIN_DATA_DIR =

# GitHub Token（仅在本地发布 Release 时需要）
# GITHUB_TOKEN =
