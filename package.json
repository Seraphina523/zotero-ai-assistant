{
  "name": "zotero-ai-assistant",
  "type": "module",
  "version": "0.1.0",
  "description": "AI assistant for Zotero: summaries, translation, figure interpretation, critical appraisal, full-text Q&A with page citations, and idea discovery across your library.",
  "keywords": [
    "zotero",
    "zotero-plugin",
    "ai",
    "llm",
    "paper-summary",
    "pdf-qa",
    "research",
    "openai",
    "claude",
    "deepseek"
  ],
  "config": {
    "addonName": "Zotero AI Assistant",
    "addonID": "zotero-ai-assistant@local",
    "addonRef": "zoteroai",
    "addonInstance": "ZoteroAIAssistant",
    "prefsPrefix": "extensions.zotero.zoteroai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seraphina523/zotero-ai-assistant.git"
  },
  "author": "Seraphina523",
  "bugs": {
    "url": "https://github.com/Seraphina523/zotero-ai-assistant/issues"
  },
  "homepage": "https://github.com/Seraphina523/zotero-ai-assistant#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.3",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
